# Real AWS S3 / CloudFront. Copy the relevant lines into .env, replacing the MinIO block.
# See docs/feasibility/06-aws-s3-cloudfront-setup.md
#
# NOTE: S3_ENDPOINT and S3_FORCE_PATH_STYLE are MinIO-only and must be REMOVED for AWS,
# not just left blank-ish. An endpoint still pointing at localhost sends uploads nowhere,
# and forced path style breaks TLS certificate matching in several regions.

S3_BUCKET=snapmart-cms-media-dev
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# CloudFront distribution domain (recommended) or the S3 URL for a quick test.
# No trailing slash.
CDN_BASE_URL=https://dxxxxxxxxxxxxx.cloudfront.net

# On EKS with an IRSA role, omit S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY entirely so the
# SDK's default credential chain picks the role up.
