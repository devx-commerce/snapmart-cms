# ---- Payload ----
PAYLOAD_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---- Database (docker compose: postgres on 5433) ----
DATABASE_URL=postgres://snapmart:snapmart@127.0.0.1:5433/snapmart_cms

# ---- Object storage (docker compose: MinIO stands in for S3) ----
# In AWS these become the real bucket, region and IAM credentials.
S3_BUCKET=snapmart-cms-media
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=snapmart
S3_SECRET_ACCESS_KEY=snapmart123
S3_FORCE_PATH_STYLE=true

# ---- CDN ----
# The public base URL assets are served from. Locally this is MinIO itself;
# in AWS it is the CloudFront distribution domain in front of the bucket.
# This single variable is the whole difference between local and production.
CDN_BASE_URL=http://localhost:9000/snapmart-cms-media

# ---- Outward webhook (Phase 5) ----
# Where publish events are announced. In production this is the BFF revalidation
# endpoint and/or a CloudFront invalidation trigger. Unset = the hook is inert.
CACHE_WEBHOOK_URL=http://localhost:4555/invalidate
CACHE_WEBHOOK_SECRET=change-me
